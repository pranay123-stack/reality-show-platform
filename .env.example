# ---------------------------------------------------------------------------
# Reality Platform — environment template
# Copy to .env (`pnpm setup:env`) and adjust. NEVER commit a filled-in .env.
# All secrets below are obvious dev placeholders and are rejected in production.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0

# --- Datastores -------------------------------------------------------------
# Host ports are deliberately non-default (5432/6379 are taken on many machines).
POSTGRES_USER=reality
POSTGRES_PASSWORD=reality
POSTGRES_DB=reality
POSTGRES_PORT=5442
REDIS_PORT=6389

DATABASE_URL=postgresql://reality:reality@localhost:5442/reality?schema=public
REDIS_URL=redis://localhost:6389

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=dev-cookie-secret-change-me-0123456789abcdef
COOKIE_DOMAIN=localhost

# --- Web / CORS -------------------------------------------------------------
WEB_PORT=3010
CORS_ORIGIN=http://localhost:3010
WEB_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Reality Platform

# --- Limits / tuning --------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_WINDOW=1 minute
POLL_BROADCAST_THROTTLE_MS=250
HEAT_RECOMPUTE_INTERVAL_MS=60000
LEADERBOARD_CACHE_TTL_S=60

# --- Outbound transports (placeholders in development) ----------------------
MAIL_DRIVER=console
MAIL_FROM=no-reply@reality.local
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

OTP_DRIVER=console

# --- OAuth placeholder (architecture only until enabled) --------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LOG_LEVEL=info
