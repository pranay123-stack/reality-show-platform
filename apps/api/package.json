{
  "name": "@reality/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:create": "dotenv -e ../../.env -- prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:local": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:seed:prod": "tsx prisma/seed.ts",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "clean": "rm -rf dist .turbo node_modules/.cache"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@prisma/client": "6.19.3",
    "@reality/shared": "workspace:*",
    "@socket.io/redis-adapter": "8.3.0",
    "dotenv": "16.4.7",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "jose": "^6.2.8",
    "socket.io": "4.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@reality/config": "workspace:*",
    "@types/node": "22.20.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.3",
    "tsup": "8.5.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
